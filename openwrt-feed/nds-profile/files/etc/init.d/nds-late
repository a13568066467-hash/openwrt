#!/bin/sh /etc/rc.common
# Keep guest DHCP alive for NDS-WiFi clients.
#
# openNDS needs br-guest to have an address. dnsmasq only emits the guest
# dhcp-range when that address exists. After network/wifi reloads, Newifi
# often leaves br-guest DOWN (DEVICE_CLAIM_FAILED) — phones associate but
# never get an IP. Boot + hotplug + a light watchdog cover that flap.

START=25
STOP=10
USE_PROCD=1

ensure_once() {
	[ -x /usr/lib/nds-profile/ensure-guest-dhcp.sh ] || return 0
	/usr/lib/nds-profile/ensure-guest-dhcp.sh || true
}

start_service() {
	[ "$(uci -q get opennds.@opennds[0].enabled)" = "1" ] || return 0

	ensure_once
	sleep 2

	# Watchdog: every 30s re-check br-guest + dhcp-range (no-op when healthy).
	procd_open_instance
	procd_set_param command /bin/sh -c 'while true; do /usr/lib/nds-profile/ensure-guest-dhcp.sh >/dev/null 2>&1 || true; sleep 30; done'
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	:
}

service_triggers() {
	procd_add_reload_trigger "network" "wireless" "dhcp" "opennds"
}

reload_service() {
	ensure_once
}
