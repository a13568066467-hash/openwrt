#!/bin/sh
# First-boot configuration for the NDS billing gateway.
#
# Package selection happens at build time (see build/configs/*.config), so this
# script only writes UCI. In particular it must not try to install anything:
# OpenWrt 25.12 uses apk, and a first-boot device has no network yet anyway.

CLOUD_HOST="${NDS_CLOUD_HOST:-portal.local}"
CLOUD_PORT="${NDS_CLOUD_PORT:-8443}"
CLOUD_SCHEME="${NDS_CLOUD_SCHEME:-https}"
CLOUD_ZONE="${NDS_CLOUD_ZONE:-wan}"
CLOUD_PATH="${NDS_CLOUD_PATH:-/fas}"
BASE_MAC="$(cat /sys/class/net/br-lan/address 2>/dev/null || cat /sys/class/net/eth0/address 2>/dev/null || echo unknown)"
DEVICE_SUFFIX="$(echo "$BASE_MAC" | tr -d ':' | tr 'A-F' 'a-f')"
DEVICE_ID="${NDS_DEVICE_ID:-NewWiFI-${DEVICE_SUFFIX}}"
DEVICE_SECRET="${NDS_DEVICE_SECRET:-}"
GUEST_SSID="${NDS_GUEST_SSID:-NDS-WiFi}"
GUEST_SUBNET="${NDS_GUEST_SUBNET:-192.168.100.1}"

if [ -z "$DEVICE_SECRET" ]; then
	DEVICE_SECRET="$(dd if=/dev/urandom bs=16 count=1 2>/dev/null | hexdump -ve '1/1 "%02x"')"
fi

# Guest bridge. Declared as a device section rather than the legacy
# `option type bridge`, which is what netifd expects since OpenWrt 21.02.
uci -q batch <<EOF
delete network.guest_dev
set network.guest_dev=device
set network.guest_dev.name='br-guest'
set network.guest_dev.type='bridge'

delete network.guest
set network.guest=interface
set network.guest.device='br-guest'
set network.guest.proto='static'
set network.guest.ipaddr='${GUEST_SUBNET}'
set network.guest.netmask='255.255.255.0'
EOF

# openNDS has no IPv6 support, so a client with a routable IPv6 address would
# reach the internet without ever passing the portal. The guest network is
# therefore kept IPv4-only: no prefix delegated, no RA, no DHCPv6.
uci -q batch <<EOF
set network.guest.delegate='0'
set network.guest.ipv6='0'
set network.wan6.disabled='1'

delete dhcp.guest
set dhcp.guest=dhcp
set dhcp.guest.interface='guest'
set dhcp.guest.start='100'
set dhcp.guest.limit='150'
set dhcp.guest.leasetime='12h'
# force=1: keep emitting dhcp-range even if guest briefly lacks an address
# (otherwise phones associate to NDS-WiFi but never receive an IP).
set dhcp.guest.ignore='0'
set dhcp.guest.force='1'
set dhcp.guest.dhcpv4='server'
set dhcp.guest.ra='disabled'
set dhcp.guest.dhcpv6='disabled'
set dhcp.guest.ndp='disabled'
delete dhcp.guest.dhcp_option_force
add_list dhcp.guest.dhcp_option_force='114,http://home.me'
del_list dhcp.@dnsmasq[0].address='/home.me/${GUEST_SUBNET}'
add_list dhcp.@dnsmasq[0].address='/home.me/${GUEST_SUBNET}'
EOF

# Guest zone: forwarding to WAN is what openNDS gates. Input is rejected apart
# from the services a client must reach before it can authenticate — without
# these rules a client never even gets a DHCP lease.
uci -q batch <<EOF
delete firewall.guest
set firewall.guest=zone
set firewall.guest.name='guest'
set firewall.guest.network='guest'
set firewall.guest.input='REJECT'
set firewall.guest.output='ACCEPT'
set firewall.guest.forward='REJECT'

delete firewall.guest_to_wan
set firewall.guest_to_wan=forwarding
set firewall.guest_to_wan.src='guest'
set firewall.guest_to_wan.dest='wan'

delete firewall.guest_dhcp
set firewall.guest_dhcp=rule
set firewall.guest_dhcp.name='Allow-DHCP-Guest'
set firewall.guest_dhcp.src='guest'
set firewall.guest_dhcp.proto='udp'
set firewall.guest_dhcp.dest_port='67'
set firewall.guest_dhcp.family='ipv4'
set firewall.guest_dhcp.target='ACCEPT'

delete firewall.guest_dns
set firewall.guest_dns=rule
set firewall.guest_dns.name='Allow-DNS-Guest'
set firewall.guest_dns.src='guest'
set firewall.guest_dns.proto='tcp udp'
set firewall.guest_dns.dest_port='53'
set firewall.guest_dns.target='ACCEPT'

delete firewall.guest_portal
set firewall.guest_portal=rule
set firewall.guest_portal.name='Allow-openNDS-Guest'
set firewall.guest_portal.src='guest'
set firewall.guest_portal.proto='tcp'
set firewall.guest_portal.dest_port='2050'
set firewall.guest_portal.target='ACCEPT'

delete firewall.allow_cloud_guest
set firewall.allow_cloud_guest=rule
set firewall.allow_cloud_guest.name='Allow-Cloud-Guest'
set firewall.allow_cloud_guest.src='guest'
set firewall.allow_cloud_guest.dest='${CLOUD_ZONE}'
set firewall.allow_cloud_guest.proto='tcp'
set firewall.allow_cloud_guest.dest_port='${CLOUD_PORT} 8080 8443 3000 3001'
set firewall.allow_cloud_guest.family='ipv4'
set firewall.allow_cloud_guest.target='ACCEPT'
EOF

if [ "$CLOUD_ZONE" = "lan" ]; then
	uci -q batch <<EOF
delete firewall.block_guest_lan_private
set firewall.block_guest_lan_private=rule
set firewall.block_guest_lan_private.name='Block-Guest-LAN-Private'
set firewall.block_guest_lan_private.src='guest'
set firewall.block_guest_lan_private.dest='lan'
set firewall.block_guest_lan_private.dest_ip='${LAN_IP%.*}.0/24'
set firewall.block_guest_lan_private.family='ipv4'
set firewall.block_guest_lan_private.target='REJECT'
set firewall.guest_to_lan=forwarding
set firewall.guest_to_lan.src='guest'
set firewall.guest_to_lan.dest='lan'
delete firewall.guest_to_lan_nat
set firewall.guest_to_lan_nat=nat
set firewall.guest_to_lan_nat.name='Guest-to-LAN-Masquerade'
set firewall.guest_to_lan_nat.src='lan'
set firewall.guest_to_lan_nat.src_ip='192.168.100.0/24'
set firewall.guest_to_lan_nat.target='MASQUERADE'
set firewall.guest_to_lan_nat.family='ipv4'
EOF
else
	uci -q delete firewall.guest_to_lan
	uci -q delete firewall.block_guest_lan_private
	uci -q delete firewall.guest_to_lan_nat
fi

# Open guest SSID on the first radio when wireless hardware exists. On x86_64
# VMs and other headless targets there is no radio; attach spare Ethernet
# ports to br-guest instead so openNDS still has a live gateway interface.
# Do not pipe ls through head: head exits 0 on empty input, so headless targets
# would incorrectly take the WiFi branch and never attach eth1 to br-guest.
if ls /sys/class/ieee80211/*/ >/dev/null 2>&1; then
	uci -q batch <<EOF
delete wireless.guest_radio0
set wireless.guest_radio0=wifi-iface
set wireless.guest_radio0.device='radio0'
set wireless.guest_radio0.mode='ap'
set wireless.guest_radio0.network='guest'
set wireless.guest_radio0.ssid='${GUEST_SSID}'
set wireless.guest_radio0.encryption='none'
set wireless.guest_radio0.isolate='1'
delete wireless.radio0.disabled
EOF
else
	# Do not probe sysfs here: uci-defaults can run before the driver has
	# registered eth1. Declaring the port in UCI is enough; netifd attaches it
	# once the interface appears.
	uci add_list network.guest_dev.ports='eth1'
fi

# openNDS in FAS level 1: the cloud login page sends the client through
# opennds_auth and then redirects into the user portal.
[ -n "$(uci -q get opennds.@opennds[0])" ] || uci -q add opennds opennds

uci -q batch <<EOF
set opennds.@opennds[0].enabled='1'
set opennds.@opennds[0].gatewayinterface='br-guest'
set opennds.@opennds[0].gatewayname='${DEVICE_ID}'
set opennds.@opennds[0].gatewayfqdn='home.me'
set opennds.@opennds[0].statuspath='/usr/lib/nds-hooks/client_status.sh'
set opennds.@opennds[0].fas_secure_enabled='1'
set opennds.@opennds[0].fasremotefqdn='${CLOUD_HOST}'
set opennds.@opennds[0].fasport='${CLOUD_PORT}'
set opennds.@opennds[0].faspath='${CLOUD_PATH}'
set opennds.@opennds[0].binauth='/usr/lib/nds-hooks/binauth.sh'
set opennds.@opennds[0].sessiontimeout='0'
set opennds.@opennds[0].checkinterval='5'
set opennds.@opennds[0].fwhook_enabled='1'
delete opennds.@opennds[0].walledgarden_fqdn_list
add_list opennds.@opennds[0].walledgarden_fqdn_list='${CLOUD_HOST}'
delete opennds.@opennds[0].walledgarden_port_list
add_list opennds.@opennds[0].walledgarden_port_list='443'
add_list opennds.@opennds[0].walledgarden_port_list='${CLOUD_PORT}'
EOF

uci -q batch <<EOF
set nds-agent.main.cloud_url='${CLOUD_SCHEME}://${CLOUD_HOST}:${CLOUD_PORT}'
set nds-agent.main.device_id='${DEVICE_ID}'
set nds-agent.main.device_secret='${DEVICE_SECRET}'
set nds-agent.main.report_interval='30'
EOF

for cfg in network dhcp firewall wireless opennds nds-agent; do
	uci -q commit "$cfg"
done

# openNDS ships at START=15, before network (S20). Without this change the
# daemon starts while br-guest is still down and silently fails to bind.
if grep -q '^START=15' /etc/init.d/opennds 2>/dev/null; then
	sed -i 's/^START=15/START=21/' /etc/init.d/opennds
fi

/etc/init.d/opennds enable
/etc/init.d/nds-agent enable
/etc/init.d/nds-late enable

exit 0
