#!/bin/sh /etc/rc.common
# NDS Billing Agent init script

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	# -R is explicit: older ucode builds default to template rather than script mode.
	procd_set_param command /usr/bin/ucode -R /usr/lib/nds-agent/main.uc
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	:
}

service_triggers() {
	procd_add_reload_trigger nds-agent
}
