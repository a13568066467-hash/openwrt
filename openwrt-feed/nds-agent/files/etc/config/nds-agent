
config main 'main'
	option enabled '1'
	option cloud_url 'https://portal.local:8443'
	option poll_interval '5'
	option report_interval '60'
	option request_timeout '15'
	# Set to 1 only while testing against a self-signed cloud certificate.
	option insecure_tls '0'
	option device_id ''
	option device_secret ''
	option quota_file '/etc/nds-agent/quota.json'
	option backlog_file '/etc/nds-agent/backlog.jsonl'
	option seq_file '/etc/nds-agent/seq'
