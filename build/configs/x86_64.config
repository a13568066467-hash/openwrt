# x86_64 baseline target for the NDS billing firmware.
# Kept minimal on purpose: `make defconfig` expands package dependencies,
# so only the top-level choices belong here.

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# Images suitable for QEMU verification.
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# Web UI
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

# NDS billing stack. nds-agent pulls in opennds, nds-hooks, curl,
# ucode-mod-fs and ucode-mod-uci through its DEPENDS.
CONFIG_PACKAGE_nds-agent=y
CONFIG_PACKAGE_nds-profile=y

# openNDS relies on dnsmasq's ipset/nftset support for the walled garden,
# which the default dnsmasq build does not provide.
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y

# TLS for opkg and for the agent's HTTPS transport.
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_ca-bundle=y
