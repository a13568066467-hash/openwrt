# ramips/mt7621 config for NDS Billing
# Device: Newifi D2 / 新路由3 (d-team_newifi-d2)
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_opennds=y
CONFIG_PACKAGE_nds-agent=y
CONFIG_PACKAGE_nds-hooks=y
CONFIG_PACKAGE_nds-profile=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ucode-mod-uclient=y
CONFIG_PACKAGE_ucode-mod-digest=y
CONFIG_PACKAGE_ucode-mod-json-c=y
CONFIG_PACKAGE_ucode-mod-uloop=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_jsonfilter=y
